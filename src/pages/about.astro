---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-16 md:py-20">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">About</h1>
    <p class="mt-6 text-lg text-muted">Write something about yourself here.</p>
  </section>
</Layout>
